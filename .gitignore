# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# Backend content ignored
/backend/node_modules
/backend/.env

# Frontend content ignored
.env
.vscode
.idea
# Ignore all terraform generated/sensitive files
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/tfplan
terraform/**/tfplan.bin
terraform/**/tfplan.txt
terraform/**/*.pem
terraform/**/terraform_outputs.json
terraform/**/terraform.tfstate
terraform/**/terraform.tfstate.backup
terraform/**/*.tfstate*
# terraform.tfvars contient des secrets → ne pas committer en production
# Pour le pipeline Jenkins, utiliser terraform.tfvars.example + variables Jenkins
terraform/**/terraform.tfvars
kubeconfig
kubeconfig-jenkins.yaml
